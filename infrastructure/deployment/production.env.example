# Production runtime template. Authentication and digital payments remain disabled.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://ruralconnect:CHANGE_TO_UNIQUE_SECRET@YOUR_DATABASE_HOST/ruralconnect?sslmode=verify-full
ADMIN_ORIGIN=https://YOUR_ADMIN_DOMAIN
REQUIRE_HTTPS=true
# List only actual ingress proxy IPs/CIDRs; leave blank for direct TLS termination.
TRUSTED_PROXY_CIDRS=
OTP_MODE=disabled
PAYMENT_MODE=disabled
# Never copy sandbox credentials into this environment.

# Owner-issued invitations for the private beta; never public self-selected roles.
BETA_AUTH_ENABLED=false
