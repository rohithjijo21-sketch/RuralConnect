{
  "name": "@ruralconnect/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file=../../.env --import tsx scripts/seed.ts",
    "test:embedded": "node scripts/test-embedded.mjs",
    "dev:phone": "node scripts/dev-phone.mjs",
    "beta:invite": "node --env-file=../../.env --import tsx scripts/beta-invite.ts",
    "beta:revoke": "node --env-file=../../.env --import tsx scripts/beta-revoke.ts",
    "bus:review": "node --env-file=../../.env --import tsx scripts/bus-review.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-postgis": "^0.2.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
